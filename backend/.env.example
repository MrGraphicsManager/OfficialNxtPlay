MONGO_URL=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
DB_NAME=nxtplay
JWT_SECRET=GENERATE_A_LONG_RANDOM_SECRET
CORS_ORIGINS=https://YOUR-PROJECT.vercel.app,https://nxtplay.live,https://www.nxtplay.live
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=GENERATE_A_DIFFERENT_STRONG_PASSWORD
ADMIN_NAME=NXTPLAY Admin
SEED_DEMO_DATA=false

# App Public URL (used in email links for account setup and password resets)
APP_PUBLIC_URL=https://nxtplay.live

# Email configuration
EMAIL_FROM_NAME=NXTPLAY
# If using Emergent managed email integration:
# EMERGENT_EMAIL_KEY=
# EMAIL_REPLY_TO=support@nxtplay.live

# Cryptographic Keys (Required for subscription and payment reference encryption)
# Generate a 32-byte base64 key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=GENERATE_A_FERNET_KEY

# Daily Cron Secret (Required for POST /api/subscriptions/cron/daily and POST /api/route/cron/reconcile)
CRON_SECRET=GENERATE_A_STRONG_CRON_SECRET

# Razorpay Merchant Keys (Optional for local testing, required for live checkout)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Razorpay Recurring Subscription Plans (Created in Razorpay Dashboard)
# RAZORPAY_PLAN_399=plan_...
# RAZORPAY_PLAN_699=plan_...

# Razorpay Route Payouts (Defaults to false; set to true only after Razorpay approval)
ROUTE_ENABLED=false
